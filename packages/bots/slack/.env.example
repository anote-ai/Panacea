# Required
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Socket Mode (no public URL needed)
SLACK_APP_TOKEN=xapp-...

# Optional tuning
ANOTE_MODEL=claude-sonnet-4-6
ANOTE_MAX_TOKENS=4096
PORT=3000

# Backend URL for the remote-approvals primitive (see /api/approvals)
ANOTE_BACKEND_URL=http://localhost:5000
